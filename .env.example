# Copy this file to .env and fill in your values.
# Never commit .env. It is gitignored.

# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-api03-..."

# LaunchDarkly: Organization settings > SDK keys > Test environment
# Server-side key: used by Python, Go, and Java backend services (keep secret)
LD_SERVER_SDK_KEY="sdk-..."

# Client-side ID: consumed by the Part 5 browser JavaScript SDK, which fetches it
# from the Python service's GET /client-config. Safe to expose in browser code:
# it only ever yields evaluated flag values for one context, never the ruleset.
LD_CLIENT_SIDE_ID="your-24-char-hex-id"

# REST API access token: used to turn flags on/off during the Part 1
# Release/Remediate demo, via curl or Postman (Account settings > Authorization
# > Access tokens). Needs write access to the Test environment. Keep secret.
# Use it as the Authorization header value (no "Bearer" prefix). For curl,
# export it first:
#   bash:        export LD_API_TOKEN=api-...
#   PowerShell:  $env:LD_API_TOKEN="api-..."
LD_API_TOKEN="api-..."
