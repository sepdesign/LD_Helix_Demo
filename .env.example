# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-api03-..."

# LaunchDarkly — Organization settings > SDK keys > Test environment
# Server-side key: used by Python, Go, and Java backend services (keep secret)
LD_SERVER_SDK_KEY="sdk-..."

# Client-side ID: used by the browser JS SDK (safe to expose)
LD_CLIENT_SIDE_ID="your-24-char-hex-id"
